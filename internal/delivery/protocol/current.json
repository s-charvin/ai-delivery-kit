{
  "binding": {
    "ai_delivery_path": ".ai-delivery",
    "layout": {
      "project_artifacts": {
        "retrospective_index": "retrospectives/index.md"
      },
      "requirement_artifacts": {
        "breakdown_summary": "requirements/{req_id}/breakdown-summary.md",
        "delivery_report": "requirements/{req_id}/delivery-report.md",
        "dependency_graph": "requirements/{req_id}/dependency-graph.json",
        "global_rules": "requirements/{req_id}/global-rules.md",
        "progress": "requirements/{req_id}/progress.md",
        "requirement": "requirements/{req_id}/requirement.md",
        "retrospective": "requirements/{req_id}/retrospective.md",
        "status": "requirements/{req_id}/status.json",
        "todo": "requirements/{req_id}/todo.md"
      },
      "requirement_root": "requirements/{req_id}",
      "sub_requirement_artifacts": {
        "decisions": "requirements/{req_id}/sub-requirements/{sr_id}/decisions.md",
        "readme": "requirements/{req_id}/sub-requirements/{sr_id}/README.md",
        "requirement_slice": "requirements/{req_id}/sub-requirements/{sr_id}/requirement-slice.md",
        "solution_design": "requirements/{req_id}/sub-requirements/{sr_id}/design.md",
        "traceability": "requirements/{req_id}/sub-requirements/{sr_id}/traceability.json",
        "ui_truth_index": "requirements/{req_id}/sub-requirements/{sr_id}/contracts/ui-truth-index.json",
        "verification": "requirements/{req_id}/sub-requirements/{sr_id}/verification.md",
        "visual_acceptance": "requirements/{req_id}/sub-requirements/{sr_id}/visual-acceptance.json"
      },
      "sub_requirement_dir": "requirements/{req_id}/sub-requirements/{sr_id}"
    },
    "version": 3
  },
  "naming": {
    "commit_prefix_template": "[{{subreq_id}}] ",
    "require_commit_prefix": true,
    "sub_requirement_id_pattern": "SR-%03d",
    "version": 1
  },
  "policy": {
    "archive": {
      "_doc": "In-place archive: merged -\u003e archived requires CP-ARCHIVE confirmation; canonical artifacts remain in their original locations",
      "immutable": true,
      "require_checkpoint": "CP-ARCHIVE"
    },
    "capabilities": {
      "ui_truth": {
        "checkpoint": "CP-UI",
        "index": "contracts/ui-truth-index.json",
        "modes": {
          "existing": {
            "enabled": false,
            "final_acceptance": "ordinary_behavior_and_semantic_tests",
            "requires_index": false,
            "requires_preview": false,
            "stage2": false
          },
          "figma": {
            "enabled": true,
            "final_acceptance": "visual_acceptance",
            "requires_index": true,
            "requires_preview": true,
            "stage2": true
          },
          "none": {
            "enabled": false,
            "final_acceptance": "ordinary_behavior_and_semantic_tests",
            "requires_index": false,
            "requires_preview": false,
            "stage2": false
          },
          "runtime-baseline": {
            "enabled": true,
            "final_acceptance": "visual_acceptance",
            "requires_index": true,
            "requires_preview": true,
            "stage2": true
          }
        },
        "preview": "official_host_stack_preview"
      }
    },
    "context": {
      "sources": []
    },
    "design_contract_persistence": {
      "_doc": "The living design.md is the sole behavior and solution-design contract; completed work keeps canonical artifacts in place and uses a new requirement directory for changes",
      "active": "living",
      "complete": "in_place",
      "in_place": {
        "change_requires": "new_requirement_dir",
        "source_of_truth": "canonical_artifacts"
      },
      "living": {
        "on_drift": "reopen_solution_design",
        "source_of_truth": "design.md"
      }
    },
    "gate_requirements": {
      "archive_confirmation": [
        "CP-ARCHIVE"
      ],
      "user_design_decision": [
        "CP-DESIGN"
      ]
    },
    "review_loop": {
      "max_rounds": 3
    },
    "solution_design": {
      "artifact_key": "solution_design",
      "human_checkpoint": "CP-DESIGN",
      "human_checkpoint_condition": "user_decision_required_and_no_valid_human_review",
      "required": true
    },
    "source_index_policy": {
      "required_traceability_keys": [
        "requirement",
        "figma",
        "api",
        "design",
        "pr",
        "ci",
        "visual",
        "deploy",
        "monitoring"
      ]
    },
    "status_sequence": [
      "draft",
      "split_ready",
      "acceptance_frozen",
      "design_ready",
      "in_dev",
      "visual_acceptance_passed",
      "merged",
      "archived"
    ],
    "truth_policy": {
      "conflict_behavior": "block",
      "functional_source": "Requirement",
      "visual_source": "Figma",
      "visual_sources_by_mode": {
        "existing": [],
        "figma": [
          "figma",
          "requirement",
          "project",
          "user-decision"
        ],
        "none": [],
        "runtime-baseline": [
          "requirement",
          "project",
          "user-decision"
        ]
      }
    },
    "verification_contract_version": 2,
    "verification_policy": {
      "_doc": "Verification discipline: merged/archived requires verification.md evidence; language-neutral markers keep human-readable headings localizable",
      "artifact": "verification.md",
      "required_at": [
        "merged",
        "archived"
      ],
      "required_markers": [
        "ai-delivery-verification:review-rounds",
        "ai-delivery-verification:commands-results",
        "ai-delivery-verification:sign-off"
      ]
    },
    "version": 4,
    "workflow_gates": [
      "requirement_breakdown",
      "design_contract",
      "implementation"
    ],
    "worktree_policy": {
      "allow_precreate_before_dependencies": false,
      "confirmation_scope": "current_sub_requirement",
      "external_worktree_behavior": "stop_and_ask",
      "mode": "current_checkout_unless_user_confirmed",
      "native_tool_requires_exact_path": true,
      "path_template": ".worktrees/{req_id}-{sr_id}",
      "project_local_only": true,
      "project_local_root": ".worktrees",
      "require_explicit_user_confirmation": true,
      "ui_stages_reuse_approved_workspace": true
    }
  },
  "versions": {
    "archive_evidence": 1,
    "binding": 3,
    "policy": 4,
    "status": "2.0",
    "ui_index": 3,
    "verification": 2,
    "visual_acceptance": 2
  }
}
