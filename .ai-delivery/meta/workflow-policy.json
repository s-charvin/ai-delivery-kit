{
  "version": 3,
  "truth_policy": {
    "functional_source": "Requirement",
    "visual_source": "Figma",
    "visual_sources_by_mode": {
      "none": [],
      "existing": [],
      "runtime-baseline": ["requirement", "project", "user-decision"],
      "figma": ["figma", "requirement", "project", "user-decision"]
    },
    "conflict_behavior": "block"
  },
  "workflow_gates": [
    "requirement_breakdown",
    "design_contract",
    "implementation"
  ],
  "capabilities": {
    "ui_truth": {
      "checkpoint": "CP-UI",
      "index": "contracts/ui-truth-index.json",
      "preview": "official_host_stack_preview",
      "modes": {
        "none": {
          "enabled": false,
          "stage2": false,
          "requires_index": false,
          "requires_preview": false,
          "final_acceptance": "ordinary_behavior_and_semantic_tests"
        },
        "existing": {
          "enabled": false,
          "stage2": false,
          "requires_index": false,
          "requires_preview": false,
          "final_acceptance": "ordinary_behavior_and_semantic_tests"
        },
        "runtime-baseline": {
          "enabled": true,
          "stage2": true,
          "requires_index": true,
          "requires_preview": true,
          "final_acceptance": "visual_acceptance"
        },
        "figma": {
          "enabled": true,
          "stage2": true,
          "requires_index": true,
          "requires_preview": true,
          "final_acceptance": "visual_acceptance"
        }
      }
    }
  },
  "solution_design": {
    "required": true,
    "human_checkpoint": "CP-DESIGN",
    "human_checkpoint_condition": "user_decision_required_and_no_valid_human_review",
    "artifact_key": "solution_design"
  },
  "status_sequence": [
    "draft",
    "split_ready",
    "acceptance_frozen",
    "design_ready",
    "in_dev",
    "visual_acceptance_passed",
    "merged",
    "archived"
  ],
  "source_index_policy": {
    "required_traceability_keys": [
      "requirement",
      "figma",
      "api",
      "design",
      "pr",
      "ci",
      "visual",
      "deploy",
      "monitoring"
    ]
  },
  "gate_requirements": {
    "user_design_decision": ["CP-DESIGN"],
    "archive_confirmation": ["CP-ARCHIVE"]
  },
  "worktree_policy": {
    "mode": "current_checkout_unless_user_confirmed",
    "require_explicit_user_confirmation": true,
    "confirmation_scope": "current_sub_requirement",
    "project_local_root": ".worktrees",
    "path_template": ".worktrees/{req_id}-{sr_id}",
    "project_local_only": true,
    "external_worktree_behavior": "stop_and_ask",
    "native_tool_requires_exact_path": true,
    "allow_precreate_before_dependencies": false,
    "ui_stages_reuse_approved_workspace": true
  },
  "review_loop": {
    "max_rounds": 3
  },
  "design_contract_persistence": {
    "_doc": "The living design.md is the sole behavior and solution-design contract; completed work keeps canonical artifacts in place and uses a new requirement directory for changes",
    "active": "living",
    "complete": "in_place",
    "living": {
      "source_of_truth": "design.md",
      "on_drift": "reopen_solution_design"
    },
    "in_place": {
      "source_of_truth": "canonical_artifacts",
      "change_requires": "new_requirement_dir"
    }
  },
  "verification_policy": {
    "_doc": "Verification discipline: merged/archived requires verification.md evidence; language-neutral markers keep human-readable headings localizable",
    "required_at": ["merged", "archived"],
    "artifact": "verification.md",
    "required_markers": ["ai-delivery-verification:review-rounds", "ai-delivery-verification:commands-results", "ai-delivery-verification:sign-off"]
  },
  "archive": {
    "_doc": "In-place archive: merged -> archived requires CP-ARCHIVE confirmation; canonical artifacts remain in their original locations",
    "require_checkpoint": "CP-ARCHIVE",
    "immutable": true
  },
  "updated_at": "2026-05-06T00:00:00Z",
  "updated_by": "skill-flatten-v0.0.3"
}
