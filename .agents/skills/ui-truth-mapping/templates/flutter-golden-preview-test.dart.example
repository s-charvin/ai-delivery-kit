// Golden preview skeleton for ui-truth-mapping (Flutter).
// Copy the *pattern*, not this filename. This is NOT a widget template.
// Widget code must follow neighboring production files.
// In derived project code, keep only necessary comments and human-readable
// test descriptions, and write them in the user's current conversation language.
// Do not copy these instructional comments into the project.
//
// Hard rules (from the retired HTML preview; they still apply):
// - One reviewable unit per golden. Out-of-scope shell stays out.
// - setSurfaceSize = PNG canvas (artboard snapshot), NOT a runtime width lock.
//   fill / hug / fixed lives in the widget (§5b), not in a test SizedBox.
// - One testWidgets + matchesGoldenFile per reviewable visual scenario.
//   Configure the scenario's recorded profile (surface, theme, locale,
//   text scale, reduced motion, and input mode) in the host harness.
//   Do not build a state-switcher or review panel into the widget
//   (that was HTML preview chrome, not product UI).
// - No status-bar / home-indicator / IME in the PNG unless those bars
//   are in-scope product chrome. Zero MediaQuery padding / viewPadding.
// - Motion: named keyframe PNG. Do not loop an animation in the golden.
//   Motion table → widget comments / freeze chat, not a second paint file.
//   Do not use pumpAndSettle() for shimmer/Lottie/other continuous animation:
//   disable tickers or pump an explicit, named keyframe duration instead.
//   Test trigger, interruption/reversal/cancel, reduced-motion fallback, and
//   resource disposal with project-native behavior tests outside the PNG.
// - No network. Reuse the host's ImageProvider / fixture override.
//   Cover content-image loading/error/offline fallbacks when applicable.
// - Do not add packages the host project does not already use.
// - Follow host Theme / localizations / golden harness when neighbors have them.
//   MaterialApp below is only the fallback.
//
// Generate / refresh:
//   flutter test test/path/to/unit_golden_test.dart --update-goldens
// Then give the user the PNG absolute path (repo-relative path belongs in
// contracts/ui-truth-index.json as the matching scenario's preview_path).

import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';

// import 'package:host_app/…/unit_widget.dart';

void main() {
  testWidgets('unit default scenario golden', (tester) async {
    // Preview canvas for THIS scenario — artboard snapshot, not runtime layout.
    const previewSize = Size(400, 200);
    await tester.binding.setSurfaceSize(previewSize);
    addTearDown(() => tester.binding.setSurfaceSize(null));

    await tester.pumpWidget(
      MaterialApp(
        debugShowCheckedModeBanner: false,
        // theme: hostTheme,              // prefer neighbor goldens
        // localizationsDelegates: …,     // if neighbors wrap widgets this way
        home: MediaQuery(
          data: const MediaQueryData(
            size: previewSize,
            padding: EdgeInsets.zero,
            viewPadding: EdgeInsets.zero,
            viewInsets: EdgeInsets.zero,
            textScaler: TextScaler.linear(1.0),
          ),
          child: const ColoredBox(
            color: Color(0xFFFFFFFF),
            child: Align(
              alignment: Alignment.topLeft,
              child: RepaintBoundary(
                key: const ValueKey<String>('ui-truth-preview'),
                // Replace with the real unit. Do not wrap it in snapshot-px
                // SizedBox to "match the artboard".
                child: SizedBox.shrink(),
                // child: UnitWidget(...),
              ),
            ),
          ),
        ),
      ),
    );

    // One frame keeps continuous motion deterministic. For a motion state,
    // use a separate testWidgets and an explicit pump(Duration) keyframe.
    await tester.pump();

    await expectLater(
      find.byKey(const ValueKey<String>('ui-truth-preview')),
      matchesGoldenFile('goldens/unit_default.png'),
    );
  });

  // Extra visual scenarios: copy the testWidgets above, configure the recorded
  // profile/state, and change the matchesGoldenFile name. Behavior-only
  // scenarios use focused widget/semantics tests without inventing a PNG.
  // Overlay / modal: pump that unit (or the host overlay harness) — do not nest
  // it as a page tab.
}
